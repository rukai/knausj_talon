os: linux
-

win one: key(super-1)
win two: key(super-2)
win three: key(super-3)
win four: key(super-4)
win five: key(super-5)
win six: key(super-6)
win seven: key(super-7)
win eight: key(super-8)
win nine: key(super-9)
win ten: key(super-0)

move win one: key(shift-super-1)
move win two: key(shift-super-2)
move win three: key(shift-super-3)
move win four: key(shift-super-4)
move win five: key(shift-super-5)
move win six: key(shift-super-6)
move win seven: key(shift-super-7)
move win eight: key(shift-super-8)
move win nine: key(shift-super-9)
move win ten: key(shift-super-0)

win left: key(super-h)
win right: key(super-l)
win up: key(super-k)
win down: key(super-j)

move win left: key(shift-super-h)
move win right: key(shift-super-l)
move win up: key(shift-super-k)
move win down: key(shift-super-j)

audio play: key(play)
audio next: key(next)
audio prev: key(prev)

terminal: key(super-enter)
ranger: key(super-shift-enter)
firefox: key(super-i)
talon config: key(super-f12)

# TODO: move to firefox specific or delete or something
browser previous tab: key(ctrl-pgup)
browser next tab: key(ctrl-pgdown)
browser new tab: key(ctrl-t)
browser back: key(alt-left)
browser forward: key(alt-right)
